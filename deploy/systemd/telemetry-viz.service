[Unit]
Description=Cesium Telemetry API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cskin
WorkingDirectory=/home/cskin/Cesium/heart/backend/services/telemetry-viz
ExecStart=/home/cskin/Cesium/heart/backend/services/telemetry-viz/.venv/bin/uvicorn app:app --host 0.0.0.0 --port 5701
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
