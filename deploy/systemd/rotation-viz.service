[Unit]
Description=Cesium Rotation Visualizer API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cskin
WorkingDirectory=/home/cskin/Cesium/heart/backend/services/rotation-viz
ExecStart=/home/cskin/Cesium/heart/backend/services/rotation-viz/.venv/bin/python app.py
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
