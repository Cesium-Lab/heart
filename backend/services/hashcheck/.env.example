# /etc/cesium/hashcheck.env (optional). Gmail settings come from /etc/cesium/inbox.env.

# Where the email goes (default: INBOX_TO).
# HASHCHECK_TO=you@example.com

# Paths (defaults shown).
# HASHCHECK_DATA_DIR=/srv/data
# HASHCHECK_STATE_DIR=/srv/state/hashcheck

# Keep the old list (and email) if more than this share of known files vanish at once.
# HASHCHECK_MASS_MISSING=0.2
