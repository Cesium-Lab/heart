# /etc/cesium/tasks.env (optional). The login comes from /etc/cesium/inbox.env
# (INBOX_USERNAME / INBOX_PASSWORD_HASH), so the same username and password work here.

# TASKS_DIR=/srv/state/tasks                 # tasks.json lives here
# TASKS_BACKUP_DIR=/srv/data/backups/tasks   # one dated copy per day, last 30 kept
# TASKS_IDLE_MIN=60                          # log out after this long unused (off-LAN)
