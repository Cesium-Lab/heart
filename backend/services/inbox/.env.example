# Inbox settings. Copy to /etc/cesium/inbox.env on mr-ray (never commit the real file):
#   sudo install -m 0640 -o root -g cskin backend/services/inbox/.env.example /etc/cesium/inbox.env
#   sudoedit /etc/cesium/inbox.env
#   sudo systemctl restart inbox

# Gmail account that sends the nightly digest, and a Gmail *app password* for it
# (Google Account > Security > 2-Step Verification > App passwords). Not your normal password.
INBOX_SMTP_USER=you@gmail.com
INBOX_SMTP_PASS=replace-with-16-char-app-password
# Where the digest goes (defaults to INBOX_SMTP_USER).
INBOX_TO=you@gmail.com

# Login for use outside the home network / Tailscale, and to confirm deletes.
# Make the hash with:  .venv/bin/python backend/services/inbox/server.py hash-password
INBOX_USERNAME=colin
INBOX_PASSWORD_HASH=paste-the-pbkdf2_sha256-line-here

# Defaults shown; uncomment to change.
# INBOX_HOME_NETS=192.168.0.0/24,100.64.0.0/10,fd7a:115c:a1e0::/48   # no login from these
# INBOX_DIGEST_HOUR=21
# INBOX_DIR=/srv/data/inbox
# INBOX_PORT=42904
# INBOX_PUBLIC_URL=https://cesiumlab.net/inbox/

# Upload limit at home / on Tailscale, in MB (the web stays at 95 MB because of Cloudflare).
# INBOX_HOME_UPLOAD_MB=1024
