# Planes service settings. Copy to /etc/cesium/planes.env on mr-ray (never commit the real file):
#   sudo install -m 0640 -o root -g cskin backend/services/planes/.env.example /etc/cesium/planes.env
#   sudoedit /etc/cesium/planes.env
#   sudo systemctl restart planes
# Every line is optional; the service runs without this file.

# FlightAware AeroAPI key (Personal tier), for accurate routes/times. Get it from the portal:
# https://www.flightaware.com/aeroapi/portal
AEROAPI_KEY=replace-with-your-key

# Defaults shown; uncomment to change.
# PLANES_PORT=42901
# PLANES_AIRPORT=SFO
# PLANES_RADIUS_NM=40
# PLANES_CACHE_S=10
# PLANES_SOURCE=adsbfi
# PLANES_TRACK_HOURS=5
# PLANES_REPLAY_MIN=60
# Snapshot folder; under systemd it defaults to /run/planes (RuntimeDirectory), by hand it's off.
# PLANES_STATE_DIR=/run/planes
