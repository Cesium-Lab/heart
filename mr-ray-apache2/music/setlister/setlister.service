[Unit]
Description=SETLISTER.EXE song lookup proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cskin
WorkingDirectory=/home/cskin/Cesium/heart/mr-ray-apache2/music/setlister
EnvironmentFile=/home/cskin/Cesium/heart/mr-ray-apache2/music/setlister/.env
ExecStart=/home/cskin/Cesium/heart/.venv/bin/python server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
