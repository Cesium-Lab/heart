<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>numbers — cesiumlab</title>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{background:#0a0c0f;color:#a8bccf;font-family:'IBM Plex Mono',monospace;font-size:13px;padding:24px;max-width:780px}
input[type=text]{width:100%;background:#0f1318;border:1px solid #1c2330;color:#d8eaf8;font-family:'IBM Plex Mono',monospace;font-size:18px;padding:10px 12px;outline:none;margin-bottom:20px}
input[type=text]:focus{border-color:#3a5070}
.row{display:grid;grid-template-columns:160px 1fr;gap:2px 16px;align-items:baseline;padding:3px 0;border-bottom:1px solid #111620}
.row:hover{background:#0f1318}
.lbl{color:#3a4858;font-size:11px;letter-spacing:0.08em;text-transform:uppercase}
.val{color:#d8eaf8;word-break:break-all;line-height:1.6}
.val.dim{color:#6a7d90}
.val.red{color:#ff6b6b}
.sec{margin-top:18px;margin-bottom:4px;font-size:9px;letter-spacing:0.18em;text-transform:uppercase;color:#1c2330;border-bottom:1px solid #1c2330;padding-bottom:3px}
.bit{display:inline-block;width:11px;text-align:center}
.bit.one{color:#4fc3f7}
.bit.zero{color:#1c2330}
.bit-sep{color:#1c2330;margin:0 2px}
</style>
</head>
<body>
<input type="text" id="inp" placeholder="enter a number — decimal, 0x hex, 0b binary, 0o octal" autofocus>
<div id="out"></div>
<script>
const $ = id => document.getElementById(id);

function toRows(rows) {
  return rows.map(([l,v,cls=''])=>`<div class="row"><span class="lbl">${l}</span><span class="val ${cls}">${v}</span></div>`).join('');
}
function sec(s){return`<div class="sec">${s}</div>`}

function bits32(n){
  const b=((n>>>0).toString(2)).padStart(32,'0');
  let out='';
  for(let i=0;i<32;i++){
    if(i===8||i===16||i===24) out+=`<span class="bit-sep">·</span>`;
    out+=`<span class="bit ${b[i]==='1'?'one':'zero'}">${b[i]}</span>`;
  }
  return out;
}
function bits64(n){
  // for display only — JS bitwise is 32-bit, use BigInt
  try{
    const big=BigInt(Math.trunc(n));
    const b=((big & 0xFFFFFFFFFFFFFFFFn).toString(2)).padStart(64,'0');
    let out='';
    for(let i=0;i<64;i++){
      if(i%8===0&&i>0) out+=`<span class="bit-sep">·</span>`;
      out+=`<span class="bit ${b[i]==='1'?'one':'zero'}">${b[i]}</span>`;
    }
    return out;
  }catch{return '—'}
}

function ieee754(n){
  const buf=new ArrayBuffer(4);
  new DataView(buf).setFloat32(0,n,false);
  const v=new DataView(buf).getUint32(0,false);
  const sign=(v>>>31)&1;
  const exp=((v>>>23)&0xFF);
  const mant=v&0x7FFFFF;
  const expBias=exp-127;
  const mantStr=mant.toString(2).padStart(23,'0');
  return {sign,exp,expBias,mant,mantStr,hex:'0x'+v.toString(16).toUpperCase().padStart(8,'0')};
}

function ieee754_64(n){
  const buf=new ArrayBuffer(8);
  new DataView(buf).setFloat64(0,n,false);
  const hi=new DataView(buf).getUint32(0,false);
  const lo=new DataView(buf).getUint32(4,false);
  const sign=(hi>>>31)&1;
  const exp=((hi>>>20)&0x7FF);
  const expBias=exp-1023;
  const hexStr=hi.toString(16).toUpperCase().padStart(8,'0')+lo.toString(16).toUpperCase().padStart(8,'0');
  return {sign,exp,expBias,hex:'0x'+hexStr};
}

function toRoman(n){
  if(n<1||n>3999||!Number.isInteger(n)) return null;
  const vals=[1000,900,500,400,100,90,50,40,10,9,5,4,1];
  const syms=['M','CM','D','CD','C','XC','L','XL','X','IX','V','IV','I'];
  let r='';vals.forEach((v,i)=>{while(n>=v){r+=syms[i];n-=v;}});
  return r;
}

function factorize(n){
  if(n<2||n>1e9) return null;
  let factors=[],d=2,orig=n;
  while(d*d<=n){while(n%d===0){factors.push(d);n=n/d;}d++;}
  if(n>1) factors.push(n);
  if(factors.length===1&&factors[0]===orig) return `${orig} (prime)`;
  const counts={};factors.forEach(f=>counts[f]=(counts[f]||0)+1);
  return Object.entries(counts).map(([b,e])=>e>1?`${b}^${e}`:b).join(' × ');
}

function parseInput(s){
  s=s.trim();
  if(!s) return null;
  if(/^0[xX][0-9a-fA-F]+$/.test(s)) return parseInt(s,16);
  if(/^0[bB][01]+$/.test(s)) return parseInt(s.slice(2),2);
  if(/^0[oO][0-7]+$/.test(s)) return parseInt(s.slice(2),8);
  const n=Number(s);
  return isNaN(n)?null:n;
}

function render(raw){
  const n=parseInput(raw);
  if(n===null){$('out').innerHTML='';return;}
  const isInt=Number.isInteger(n);
  const u32=n>>>0;
  const i32=n|0;
  let html='';

  // ── bases ──
  html+=sec('bases');
  html+=toRows([
    ['decimal',n.toLocaleString()],
    ['hex','0x'+(isInt?(u32.toString(16).toUpperCase().padStart(8,'0')):(Math.trunc(n)>>>0).toString(16).toUpperCase())],
    ['binary (32-bit)','<span style="font-size:11px;line-height:2">'+bits32(n)+'</span>'],
    ['octal','0o'+(u32.toString(8))],
    ['base 36',n>=0&&isInt?u32.toString(36).toUpperCase():'—'],
    ['base 64 val',n>=0&&isInt&&n<64?'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'[n]:'—'],
  ]);

  // ── integer interpretations ──
  html+=sec('integer');
  const twos=(i32>>>0).toString(16).toUpperCase().padStart(8,'0');
  html+=toRows([
    ["int8 (signed)",n>=-128&&n<=127?n:'out of range','dim'],
    ["uint8",n>=0&&n<=255?n:'out of range','dim'],
    ["int16 (signed)",n>=-32768&&n<=32767?n:'out of range','dim'],
    ["uint16",n>=0&&n<=65535?n:'out of range','dim'],
    ["int32 (signed)",i32],
    ["uint32",u32],
    ["2's complement","0x"+twos],
    ["1's complement","0x"+(~i32>>>0).toString(16).toUpperCase().padStart(8,'0')],
    ["sign-magnitude",i32<0?`−0x${Math.abs(i32).toString(16).toUpperCase()}`:'0x'+u32.toString(16).toUpperCase()],
  ]);

  // ── float32 ──
  const f32=ieee754(n);
  html+=sec('ieee 754 float32');
  html+=toRows([
    ['hex',f32.hex],
    ['sign',f32.sign===0?'0 (positive)':'1 (negative)'],
    ['exponent (raw)',f32.exp+' → biased '+f32.expBias],
    ['mantissa bits',f32.mantStr],
    ['special',isNaN(n)?'NaN':!isFinite(n)?'Infinity':Math.fround(n)===n?'exact':'rounded'],
    ['float32 value',Math.fround(n)],
  ]);

  // ── float64 ──
  const f64=ieee754_64(n);
  html+=sec('ieee 754 float64 (double)');
  html+=toRows([
    ['hex',f64.hex],
    ['sign',f64.sign===0?'0 (positive)':'1 (negative)'],
    ['exponent (raw)',f64.exp+' → biased '+f64.expBias],
    ['64-bit binary','<span style="font-size:10px;line-height:2.2">'+bits64(n)+'</span>'],
  ]);

  // ── fixed point ──
  html+=sec('fixed-point (Q formats)');
  html+=toRows([
    ['Q8.8',isInt?(n*(1<<8))+'  →  0x'+(((n*(1<<8))>>>0).toString(16).toUpperCase()):'—'],
    ['Q16.16',isInt&&Math.abs(n)<32768?(n*(1<<16)):'—'],
    ['Q1.15 (audio)',n>=-1&&n<=1?(Math.round(n*32767)):'—'],
    ['Q0.16',n>=0&&n<=1?(Math.round(n*65535)):'—'],
  ]);

  // ── number theory ──
  html+=sec('number theory');
  const roman=isInt?toRoman(Math.abs(Math.trunc(n))):null;
  const factors=isInt&&n>=2?factorize(Math.abs(Math.trunc(n))):null;
  const isPrime=factors&&factors.endsWith('(prime)');
  html+=toRows([
    ['roman numeral',roman||'—'],
    ['factorization',factors||'—'],
    ['prime',isInt?(isPrime?'yes ✓':'no'):'—'],
    ['popcount (32b)',u32.toString(2).split('').filter(b=>b==='1').length+' set bits'],
    ['trailing zeros',u32===0?32:u32.toString(2).split('').reverse().join('').indexOf('1')],
    ['next power of 2',isInt&&n>0?Math.pow(2,Math.ceil(Math.log2(n+0.5))):'—'],
    ['log₂',n>0?(Math.log2(n)).toFixed(6):'—'],
    ['log₁₀',n>0?(Math.log10(n)).toFixed(6):'—'],
    ['√n',n>=0?Math.sqrt(n).toFixed(6):'—'],
  ]);

  // ── time / size ──
  if(isInt&&u32>0){
    html+=sec('if this is...');
    const d=new Date(n*1000);
    const dMs=new Date(n);
    html+=toRows([
      ['unix timestamp',d.toISOString()+' UTC'],
      ['unix ms',dMs.toISOString()+' UTC'],
      ['bytes',n.toLocaleString()+' B → '+(n/1024).toFixed(2)+' KiB → '+(n/1048576).toFixed(4)+' MiB'],
      ['hz → period',n>0?(1/n*1000).toFixed(4)+' ms':'—'],
      ['ascii',n>=32&&n<=126?`'${String.fromCharCode(n)}' (printable)`:n<32?'control char':'—'],
      ['utf-16',n<=0x10FFFF?'U+'+n.toString(16).toUpperCase().padStart(4,'0')+' '+String.fromCodePoint(n):'—'],
      ['ipv4',n>=0&&n<=0xFFFFFFFF?[24,16,8,0].map(s=>(n>>>s)&0xFF).join('.'):'—'],
    ]);
  }

  $('out').innerHTML=html;
}

$('inp').addEventListener('input',e=>render(e.target.value));
</script>
</body>
</html>