---
import "../../../styles/setlister.css";
import "../../../styles/tuner.css";
---

<!doctype html>
<html lang="en">
  <head>
    <link rel="icon" href="/favicons/music.ico?v=5" sizes="32x32" />
    <link rel="icon" href="/favicons/music.svg?v=5" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=5" />
    <meta property="og:title" content="Tuner" />
    <meta property="og:description" content="Chromatic tuner for guitar, bass, and anything else, in the browser." />
    <meta property="og:url" content="https://cesiumlab.net/music/tuner/" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content="Chromatic tuner for guitar, bass, and anything else, in the browser" />
    <title>TUNER.EXE</title>
  </head>

  <body>
    <main class="app">
      <header class="titlebar">
        <span>♪ TUNER.EXE — PITCH DETECTION UNIT</span><span class="window-buttons" aria-hidden="true"
          ><i>_</i><i>□</i><i>×</i></span
        >
      </header>
      <nav class="toolbar" aria-label="Links">
        <a class="button" href="/music/setlister/">← Setlister</a>
        <a class="button" href="/music/taptempo/">TapTempo</a>
        <span class="tu-keys"><kbd>Space</kbd> start/stop · <kbd>V</kbd> needle/strobe · <kbd>R</kbd> reference tone</span>
      </nav>

      <section class="tu-workspace">
        <article class="panel">
          <header class="panel-title">
            <span id="modeLabel">NEEDLE</span>
            <button id="viewToggle" class="small" title="Switch display (V)">Strobe view</button>
          </header>
          <div class="tu-body">
            <div class="tu-note" aria-live="polite">
              <span id="noteName">—</span><sub id="noteOctave"></sub>
            </div>
            <div id="stringHint" class="tu-hint"></div>

            <div id="needleView" class="tu-gauge">
              <svg viewBox="-110 -110 220 125" aria-hidden="true">
                <path class="tu-arc" d="M -95 0 A 95 95 0 0 1 95 0"></path>
                <path class="tu-zone" d="M -3.3 -94.9 A 95 95 0 0 1 3.3 -94.9"></path>
                <g id="ticks"></g>
                <g id="needle"><line x1="0" y1="8" x2="0" y2="-88"></line><circle r="6"></circle></g>
              </svg>
              <div class="tu-scale"><span>-50</span><span>-25</span><span>0</span><span>+25</span><span>+50</span></div>
            </div>

            <div id="strobeView" class="tu-strobe" hidden>
              <div id="strobeA" class="tu-stripes"></div>
              <div id="strobeB" class="tu-stripes fine"></div>
              <div class="tu-strobe-mark" aria-hidden="true"></div>
              <small>stripes stand still when in tune · drift right = sharp, left = flat</small>
            </div>

            <div class="tu-readout">
              <span><b id="cents">—</b> cents</span>
              <span><b id="hz">—</b> Hz</span>
              <span>target <b id="target">—</b> Hz</span>
            </div>

            <div class="tu-row">
              <button id="startStop" class="primary tu-big">🎤 Start tuner</button>
              <button id="refTone" class="tu-big" title="Play the target note (R)">♪ Reference tone</button>
            </div>
            <div id="msg" class="tu-msg"></div>
          </div>
        </article>

        <article class="panel">
          <header class="panel-title"><span>SETUP</span></header>
          <div class="tu-body">
            <label class="tu-field"
              >Tuning
              <select id="preset">
                <option value="chromatic">Chromatic (any note)</option>
                <option value="guitar">Guitar · standard (E A D G B E)</option>
                <option value="dropd">Guitar · drop D (D A D G B E)</option>
                <option value="bass4">Bass · 4-string (E A D G)</option>
                <option value="bass5">Bass · 5-string (B E A D G)</option>
              </select>
            </label>
            <div id="strings" class="tu-strings" aria-label="Strings (click to play the note)"></div>

            <label class="tu-field"
              >A4 reference
              <span class="tu-a4">
                <button id="a4Down" class="small" aria-label="Lower A4">−</button>
                <input id="a4" type="number" min="400" max="480" step="1" value="440" aria-label="A4 in Hz" />
                <span>Hz</span>
                <button id="a4Up" class="small" aria-label="Raise A4">+</button>
                <button id="a4Reset" class="small">440</button>
              </span>
            </label>

            <label class="tu-field"
              >Reference tone volume
              <input id="volume" type="range" min="0" max="1" step="0.05" value="0.4" />
            </label>

            <p class="tu-note-small">
              In tune = within ±2 cents (green). Hold a single string, let it ring; the needle settles in
              a moment. Your browser asks for the microphone once; nothing is recorded or uploaded.
            </p>
          </div>
        </article>
      </section>
      <footer class="footer">Runs entirely in your browser. Audio never leaves this page.</footer>
    </main>

    <script>
      import "../../../scripts/tuner.js";
    </script>
  </body>
</html>
