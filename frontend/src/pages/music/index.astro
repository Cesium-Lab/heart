---
import "../../styles/music.css";

// Edit the lists here. `note` is shown under the link; `href` empty = plain text (no link).
const tools = [
  { name: "Setlister", href: "/music/setlister/", note: "Build and reorder setlists" },
  { name: "TapTempo", href: "/music/taptempo/", note: "Tap tempo, metronome, count-ins" },
  { name: "Tuner", href: "/music/tuner/", note: "Guitar, bass, anything: needle or strobe" },
  { name: "Piano", href: "/music/piano/", note: "Piano in the browser" },
];

// The note sections (Licks to learn, Song ideas, Music tools) come from your Notes buckets on
// mr-ray, read-only, via /inbox/music.json (scripts/music-notes.js). Edit them in /inbox/notes/.
const noteSections = [
  { id: "licks", title: "Licks to learn" },
  { id: "song-ideas", title: "Song ideas" },
  { id: "music-tools", title: "Music tools" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <link rel="icon" href="/favicons/music.ico?v=5" sizes="32x32" />
    <link rel="icon" href="/favicons/music.svg?v=5" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=5" />
    <meta charset="utf-8" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@400;700&display=swap" rel="stylesheet" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content="Music tools and links" />
    <meta property="og:title" content="Music" />
    <meta property="og:url" content="https://cesiumlab.net/music/" />
    <title>MUSIC.EXE</title>
  </head>

  <body>
    <a class="mu-bar" href="/music/tuner/">New: the tuner is live. Tune up →</a>

    <header class="mu-head">
      <a class="mu-logo" href="/music/">Music</a>
      <nav aria-label="Sections">
        <a href="#tools">Tools</a>
        <a href="#listen">Listen</a>
        {noteSections.map((s) => <a href={`#${s.id}`}>{s.title}</a>)}
        <a class="mu-ext" href="https://monarchonstage.com/" target="_blank" rel="noopener">MONARCH ↗</a>
        <a class="mu-ext" href="/">Cesium Lab</a>
      </nav>
    </header>

    <main>
      <section id="tools" class="mu-section">
        <h2>Tools</h2>
        <div class="mu-grid mu-tools">
          {
            tools.map((t) => (
              <a class="mu-btn" href={t.href}>
                <b>{t.name}</b>
                <span>{t.note}</span>
              </a>
            ))
          }
        </div>
      </section>

      <section id="listen" class="mu-section">
        <h2>Listen &amp; watch <span id="lwCount" class="mu-count"></span></h2>
        <div class="mu-grid">
          <form id="lwAdd" class="mu-add" hidden>
            <input name="link" placeholder="Paste a YouTube, Shorts, reel, or Spotify link" inputmode="url" />
            <input name="title" placeholder="Title (optional: looked up from the link)" />
            <button class="mu-red">Add</button>
          </form>
          <form id="lwLogin" class="mu-add" hidden>
            <input name="username" placeholder="Username" autocomplete="username" autocapitalize="none" required />
            <input type="password" name="password" placeholder="Password" autocomplete="current-password" required />
            <button class="mu-red">Log in to edit</button>
          </form>
          <div id="lwMsg" class="mu-msg"></div>
          <ul id="lwTodo" class="mu-check"></ul>
          <details id="lwDoneBox" class="mu-done" hidden>
            <summary>Done (<span id="lwDoneN">0</span>)</summary>
            <ul id="lwDone" class="mu-check"></ul>
          </details>
          <button id="lwEdit" class="mu-plus" hidden>Log in to add or check off</button>
        </div>
      </section>

      <div class="mu-cols">
        {
          noteSections.map((s) => (
            <section id={s.id} class="mu-section" data-bucket={s.id}>
              <h2>
                {s.title}
                <a class="mu-editnotes" href={`/inbox/notes/${s.id}`} hidden>Edit in Notes ↗</a>
              </h2>
              <ul class="mu-grid mu-links">
                <li><small>Loading…</small></li>
              </ul>
            </section>
          ))
        }
      </div>
    </main>


    <script>
      import "../../scripts/listen.js";
      import "../../scripts/music-notes.js";
    </script>
  </body>
</html>
