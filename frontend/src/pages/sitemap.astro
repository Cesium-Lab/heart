---
// Subway map of the site: each section is a line, pages are stations, Home is the interchange.
// Coordinates are in the SVG's 760x560 space. `side` = where the label sits.
const HOME = { x: 380, y: 280 };
const lines = [
  {
    name: "Main", color: "#e4002b",
    path: [[380, 280], [680, 280], [720, 320], [720, 520]],
    stops: [
      { name: "About Me", href: "/about_me/", x: 460, y: 280, side: "up" },
      { name: "Everything Hub", href: "/everything-hub/", x: 550, y: 280, side: "down" },
      { name: "Clock", href: "/now/", x: 640, y: 280, side: "up" },
      { name: "Status", href: "/status/", x: 720, y: 360, side: "left" },
      { name: "Inbox 🔒", href: "/inbox/", x: 720, y: 410, side: "left" },
      { name: "Tasks 🔒", href: "/tasks/", x: 720, y: 455, side: "left" },
      { name: "Docs 🔒 ↗", href: "https://docs.cesiumlab.net/docs/", x: 720, y: 500, side: "left" },
    ],
  },
  {
    name: "Music", color: "#ffb000",
    path: [[380, 280], [380, 200], [460, 120], [720, 120]],
    stops: [
      { name: "Music", href: "/music/", x: 380, y: 200, side: "left" },
      { name: "Setlister", href: "/music/setlister/", x: 500, y: 120, side: "up" },
      { name: "TapTempo", href: "/music/taptempo/", x: 595, y: 120, side: "up" },
      { name: "Tuner", href: "/music/tuner/", x: 690, y: 120, side: "up" },
    ],
  },
  {
    name: "Nerd", color: "#0078d4",
    path: [[380, 280], [60, 280]],
    stops: [
      { name: "SFO Planes", href: "/planes/", x: 300, y: 280, side: "down" },
      { name: "Rotation Viz", href: "/rotation-viz/rotation-visualizer/", x: 200, y: 280, side: "up" },
      { name: "DataViz ↗", href: "https://dataviz.cesiumlab.net", x: 95, y: 280, side: "down" },
    ],
  },
  {
    name: "Dashboards", color: "#00a651",
    path: [[380, 280], [380, 360], [300, 440], [80, 440]],
    stops: [
      { name: "System Stats", href: "/dash/system/", x: 380, y: 360, side: "right" },
      { name: "Visitor Log", href: "/dash/visitors/", x: 250, y: 440, side: "down" },
      { name: "Vibes Only", href: "/dash/vibes/", x: 120, y: 440, side: "down" },
    ],
  },
  {
    name: "Other dimensions", color: "#8e44ad",
    path: [[380, 280], [150, 50]],
    stops: [
      { name: "Cyberspace", href: "/Others/cyberspace/", x: 334, y: 234, side: "lowleft" },
      { name: "Terminal", href: "/Others/terminal/", x: 288, y: 188, side: "lowleft" },
      { name: "Minimal Mode", href: "/Others/minimal/", x: 242, y: 142, side: "lowleft" },
      { name: "Sites I Don't Need", href: "/Others/sites-i-dont-need/", x: 196, y: 96, side: "lowleft" },
      { name: "Old Homepage", href: "/Others/old_index/", x: 150, y: 50, side: "lowleft" },
    ],
  },
];
const pts = (path) => path.map(([x, y]) => `${x},${y}`).join(" ");
const label = (s) =>
  ({
    up: { x: s.x, y: s.y - 14, anchor: "middle" },
    down: { x: s.x, y: s.y + 26, anchor: "middle" },
    left: { x: s.x - 14, y: s.y + 6, anchor: "end" },
    right: { x: s.x + 14, y: s.y + 6, anchor: "start" },
    lowleft: { x: s.x - 16, y: s.y + 16, anchor: "end" }, // under a diagonal line
  })[s.side];
const external = (href) => href.startsWith("http");
---

<!DOCTYPE html>
<html lang="en">
<head>
<link rel="icon" href="/favicon.ico?v=5" sizes="32x32" />
<link rel="icon" href="/favicon.svg?v=5" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=5" />
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>★ Site Map — Colin's Internet Home ★</title>
<style is:inline>
  @import url('https://fonts.googleapis.com/css2?family=VT323&family=Press+Start+2P&display=swap');
  * { box-sizing: border-box; }
  body { min-height: 100vh; margin: 0; padding: 20px; overflow-x: hidden; background-color: #008080; background-image: repeating-linear-gradient(45deg, rgba(255,255,255,.04) 0 2px, transparent 2px 12px), repeating-linear-gradient(-45deg, rgba(0,0,0,.04) 0 2px, transparent 2px 12px); color: #000080; font-family: 'VT323', 'Courier New', monospace; font-size: 22px; line-height: 1.3; }
  body::after { content: ""; position: fixed; inset: 0; z-index: 999; pointer-events: none; background: repeating-linear-gradient(transparent 0, transparent 2px, rgba(0,0,0,.08) 2px, rgba(0,0,0,.08) 3px); }
  .frame { max-width: 720px; margin: 0 auto; border: 2px solid #fff; background: #c0c0c0; box-shadow: 4px 4px 0 #000, inset 1px 1px 0 #fff, inset -2px -2px 0 #808080; }
  .titlebar { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 4px 8px; background: linear-gradient(90deg, #000080, #1084d0); color: #fff; font-family: 'Press Start 2P', monospace; font-size: 10px; }
  .btns { display: flex; gap: 2px; }
  .btn { width: 16px; height: 14px; border: 1px solid; border-color: #fff #000 #000 #fff; background: #c0c0c0; color: #000; font-size: 10px; line-height: 12px; text-align: center; }
  .inner { padding: 20px; }
  h1 { margin: 8px 0 10px; color: #ff0080; font-family: 'Press Start 2P', monospace; font-size: 20px; line-height: 1.4; text-align: center; text-shadow: 2px 2px 0 #ffff00, 4px 4px 0 #00ffff; }
  .intro { margin: 0 0 18px; text-align: center; }
  .map-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .map-group { border: 2px inset #fff; padding: 10px 12px; background: #fff; }
  h2 { margin: -10px -12px 8px; padding: 5px 8px; background: #000080; color: #ffff00; font-family: 'Press Start 2P', monospace; font-size: 10px; line-height: 1.5; }
  ul { margin: 0; padding: 0; list-style: none; }
  li { margin: 7px 0; }
  li::before { content: "└─ "; color: #ff00ff; }
  a { color: #0000ff; font-weight: bold; }
  a:visited { color: #800080; }
  a:hover { background: #ffff00; color: #ff00ff; }
  .note { color: #555; font-size: 16px; }
  .metro { margin: 0 0 16px; border: 2px inset #fff; background: #fff; }
  .metro svg { display: block; width: 100%; height: auto; }
  .metro .line { fill: none; stroke-width: 9; stroke-linecap: round; stroke-linejoin: round; }
  .metro .stop { fill: #fff; stroke-width: 4; }
  .metro text { font-family: 'VT323', monospace; font-size: 19px; fill: #000080; }
  .metro a:hover text { fill: #ff00ff; }
  .metro a:hover .stop { fill: #ffff00; }
  .metro .home circle { fill: #fff; stroke: #000; stroke-width: 5; }
  .metro .home text { font-family: 'Press Start 2P', monospace; font-size: 13px; fill: #000; }
  .legend { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 16px; padding: 8px; border-top: 2px groove #fff; font-size: 18px; }
  .legend span::before { content: ""; display: inline-block; width: 22px; height: 7px; margin-right: 6px; vertical-align: middle; border-radius: 4px; background: var(--c); }
  hr { margin: 18px 0 14px; border: 0; border-top: 2px ridge #fff; }
  .footer { margin: 0; text-align: center; font-size: 16px; }
  @media (max-width: 560px) { body { padding: 10px; } .inner { padding: 15px; } .map-grid { grid-template-columns: 1fr; } .titlebar { font-size: 8px; } }
</style>
</head>
<body>
  <main class="frame">
    <div class="titlebar"><span>★ SITE_MAP.EXE</span><span class="btns" aria-hidden="true"><span class="btn">_</span><span class="btn">□</span><span class="btn">×</span></span></div>
    <div class="inner">
      <h1>SITE MAP</h1>
      <p class="intro">Every known corner of this computer, neatly indexed.</p>
      <figure class="metro" aria-label="Subway map of the site">
        <svg viewBox="0 0 760 560" role="img">
          <title>Site map as a subway map</title>
          {lines.map((l) => <polyline class="line" points={pts(l.path)} stroke={l.color} />)}
          {
            lines.map((l) =>
              l.stops.map((s) => (
                <a href={s.href} {...(external(s.href) ? { target: "_blank", rel: "noopener" } : {})}>
                  <circle class="stop" cx={s.x} cy={s.y} r="8" stroke={l.color} />
                  <text x={label(s).x} y={label(s).y} text-anchor={label(s).anchor}>{s.name}</text>
                </a>
              )),
            )
          }
          <a class="home" href="/">
            <circle cx={HOME.x} cy={HOME.y} r="15" />
            <text x={HOME.x + 22} y={HOME.y + 32}>HOME</text>
          </a>
        </svg>
        <figcaption class="legend">
          {lines.map((l) => <span style={`--c:${l.color}`}>{l.name}</span>)}
          <span style="--c:transparent">🔒 = login · ↗ = other site</span>
        </figcaption>
      </figure>
      <div class="map-grid">
        <section class="map-group"><h2>★ MAIN PAGES</h2><ul>
          <li><a href="/">Internet Home</a></li><li><a href="/about_me/">About Me</a></li><li><a href="/everything-hub/">Everything Hub</a></li><li><a href="/now/">Clock</a></li><li><a href="/inbox/">Inbox</a> <span class="note">(private)</span></li><li><a href="/tasks/">Tasks</a> <span class="note">(private)</span></li><li><a href="https://docs.cesiumlab.net/docs/">Docs</a> <span class="note">(private)</span></li><li><a href="https://docs.cesiumlab.net/music/">Music notes</a> <span class="note">(private)</span></li><li><a href="/status/">Status</a></li>
        </ul></section>
        <section class="map-group"><h2>★ DASHBOARDS</h2><ul>
          <li><a href="/dash/system/">System Stats</a></li><li><a href="/dash/visitors/">Visitor Log</a></li><li><a href="/dash/vibes/">Vibes Only</a></li>
        </ul></section>
        <section class="map-group"><h2>★ VISUALIZERS</h2><ul>
          <li><a href="/rotation-viz/rotation-visualizer/">Rotation Visualizer</a></li><li><a href="/music/">Music</a></li><li><a href="/music/setlister/">Setlister</a></li><li><a href="/music/taptempo/">TapTempo</a></li><li><a href="/music/tuner/">Tuner</a></li><li><a href="/planes/">SFO Planes</a></li><li><a href="https://dataviz.cesiumlab.net">DataViz</a></li>
        </ul></section>
        <section class="map-group"><h2>★ OTHER DIMENSIONS</h2><ul>
          <li><a href="/Others/cyberspace/">Cyberspace</a></li><li><a href="/Others/terminal/">Terminal</a></li><li><a href="/Others/minimal/">Minimal Mode</a></li><li><a href="/Others/sites-i-dont-need/">Sites I Don't Need</a></li><li><a href="/Others/old_index/">Old Homepage</a> <span class="note">(archive)</span></li>
        </ul></section>
      </div>
      <hr><p class="footer">[ <a href="/">return home</a> ] &nbsp; ★ &nbsp; end of map</p>
    </div>
  </main>
</body>
</html>
